# bakery-hours 환경 변수. 이 파일을 .env로 복사한 뒤 값을 채운다. .env는 저장소에 올리지 않는다.
# 이름과 기본값의 근거: docs/plan/01_공통규칙.md 11절. 검사 규칙: docs/plan/05_소스.md 8-2절.

# 관리자 비밀번호. 12자 이상 200자 이하. 비어 있으면 서버가 시작하지 않고 이 이름을 알려 준다.
ADMIN_PASSWORD=

# 세션 쿠키 서명에 쓰는 무작위 글자. 32자 이상. 비어 있으면 서버가 시작하지 않고 이 이름을 알려 준다.
SESSION_SECRET=

# 화면과 제목에 나오는 가게 이름. 1자 이상 60자 이하. 비어 있으면 서버가 시작하지 않고 이 이름을 알려 준다.
SHOP_NAME=

# 가게 시간대(IANA 이름). 비어 있으면 Asia/Seoul.
SHOP_TIME_ZONE=Asia/Seoul

# 서버 포트. 비어 있으면 4173.
PORT=4173

# SQLite 파일 경로. 비어 있으면 data/bakery.sqlite.
DB_FILE=data/bakery.sqlite
